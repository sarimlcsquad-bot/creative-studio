# Copy to .env.local for local runs, or add these in your host's environment settings.
# All of these stay on the server; none reach the browser.

# Supabase: Project Settings -> API Keys (service_role or a secret key sb_secret_...)
SUPABASE_URL=https://rwdpjjnivobwhfeibbzj.supabase.co
SUPABASE_SERVICE_KEY=

# Anthropic: console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# The password people type to open the app. Make it long.
APP_PASSWORD=

# Optional
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Optional: AI images with OpenAI (calendars, icons, illustrations, photos).
# Leave empty to hide the "New AI image" option; brand photos still work.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
OBJECT_IMAGE_QUALITY=high
